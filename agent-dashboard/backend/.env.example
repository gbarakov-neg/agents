# Copy this file to `.env` and fill in real values.
# `.env` is gitignored.

# Required if any team is configured with orchestratorProvider=openai.
# Get one at https://platform.openai.com/account/api-keys
OPENAI_API_KEY=

# Optional: override the default orchestrator provider for new teams.
# Accepts: claude | openai. Defaults to claude.
# DEFAULT_ORCHESTRATOR_PROVIDER=claude

# Optional: Notion integration (unchanged from prior behaviour).
# NOTION_TOKEN=
# NOTION_DATABASE_ID=
